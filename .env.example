# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- Claude access --------------------------------------------------------------
# Either sign in with your Claude account (Pro/Max) after starting the container:
#   docker compose exec -it dialtwin claude auth login
# or put your own API key from https://platform.claude.com here (billed per token, ~US$5-7 a face).
ANTHROPIC_API_KEY=

# Stop a job after this many tokens (0 = no limit). Protects your plan's limit or API bill from a runaway job.
MAX_TOKENS_PER_JOB=15000000

# --- Web UI -------------------------------------------------------------------
# The UI has no login. 127.0.0.1 = only this machine. Use 0.0.0.0 only on a network you trust.
HOST=127.0.0.1
PORT=8097
# The address you open in the browser (used for links in notifications).
STUDIO_URL=http://localhost:8097
TZ=UTC

# --- Faces --------------------------------------------------------------------
# Android package id prefix for every face. Pick one and keep it.
PACKAGE_PREFIX=com.dialtwin.face
# 1 = run the ideas scout every morning (~3M tokens a run). It can always be run from the Ideas page.
IDEAS_DAILY=0

# --- Notifications (optional) -------------------------------------------------
# Any URL that accepts a plain-text POST, e.g. an ntfy topic: https://ntfy.sh/your-secret-topic
NOTIFY_URL=
# Home Assistant: base URL, a long-lived access token, and notify services (comma-separated).
HA_URL=
HA_TOKEN=
HA_NOTIFY_TARGETS=
