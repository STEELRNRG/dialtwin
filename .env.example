# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- Claude access (pick ONE) -------------------------------------------------
# An API key from https://console.anthropic.com (you pay per token; a face is ~15-30M tokens,
# mostly cheap cache reads; check current pricing before a big run).
ANTHROPIC_API_KEY=
# Or your own Claude subscription: run `claude setup-token` on your computer and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# Stop a job after this many tokens (0 = no limit).
MAX_TOKENS_PER_JOB=40000000

# --- Web UI -------------------------------------------------------------------
# The UI has no login. 127.0.0.1 = only this machine. Use 0.0.0.0 only on a network you trust.
HOST=127.0.0.1
PORT=8097
# The address you open in the browser (used for links in notifications).
STUDIO_URL=http://localhost:8097
TZ=UTC

# --- Faces --------------------------------------------------------------------
# Android package id prefix for every face. Pick one and keep it.
PACKAGE_PREFIX=com.dialtwin.face
# 1 = run the ideas scout every morning (~3M tokens a run). It can always be run from the Ideas page.
IDEAS_DAILY=0

# --- Notifications (optional) -------------------------------------------------
# Any URL that accepts a plain-text POST, e.g. an ntfy topic: https://ntfy.sh/your-secret-topic
NOTIFY_URL=
# Home Assistant: base URL, a long-lived access token, and notify services (comma-separated).
HA_URL=
HA_TOKEN=
HA_NOTIFY_TARGETS=
